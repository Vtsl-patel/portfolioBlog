# Public origin of the deployed site (no trailing slash).
# Drives metadataBase, canonical URLs, sitemap, robots and structured data.
# On Vercel this is optional: it falls back to VERCEL_PROJECT_PRODUCTION_URL /
# VERCEL_URL. Set it explicitly once you attach a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console verification token.
# GOOGLE_SITE_VERIFICATION=
